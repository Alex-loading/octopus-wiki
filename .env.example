# Content source mode: auto | static | database | hybrid
# auto: when Supabase env exists, read from database first; otherwise fallback to static
VITE_CONTENT_SOURCE=auto

# Supabase runtime read configuration (required when VITE_CONTENT_SOURCE=database)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only variables for Vercel Functions. Never prefix these with VITE_.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_MEDIA_SIGNING_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 读取服务使用的 Chrome。macOS 默认使用已安装的 Google Chrome。
BOOKMARK_CHROME_EXECUTABLE_PATH=

# 共用浏览器读取服务。线上必须配置 HTTPS 地址与服务令牌。
# 本地默认连接 127.0.0.1:4318，并读取独立用户目录中的令牌文件。
BOOKMARK_BROWSER_READER_URL=
BOOKMARK_BROWSER_READER_TOKEN=
BOOKMARK_BROWSER_READER_HOST=127.0.0.1
BOOKMARK_BROWSER_READER_PORT=4318
BOOKMARK_BROWSER_DATA_DIR=.local/bookmark-reader
# 配置在读取服务主机上，指向同一桌面中 Chrome 的远程操作页面，例如 noVNC。
# 本机 macOS 或 Windows 可以留空，登录时直接打开独立 Chrome 窗口。
BOOKMARK_BROWSER_LOGIN_URL=

# Local database migration helper only
DATABASE_URL=
