      }
    },
    {
      "block_id": "KgyodnW01o6fBPxIPqRc9DYsnEc",
      "block_type": 13,
      "ordered": {
        "elements": [
          {
            "text_run": {
              "content": "资源：MCP服务器想要向客户端提供的上下文信息源数据（例如文件内容、数据库记录、API响应等）",
