{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/bookmarks.ts": {
      "maxDuration": 90,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/collector.ts": {
      "maxDuration": 90,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/bookmark-preview.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|assets/|@|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
